{
  "manifest_version": 3,
  "name": "CP to GitHub",
  "description": "Upload your competitive programming solutions to GitHub from LeetCode, Codeforces, CodeChef, and AtCoder",
  "version": "2.0",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://codeforces.com/*",
    "https://www.codechef.com/*",
    "https://atcoder.jp/*",
    "https://api.github.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  }
}